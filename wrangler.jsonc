{
  "name": "einkaufsliste",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Seite, Skript und Icon. Der Worker läuft zuerst, damit nur Angemeldete die Liste sehen.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "einkaufsliste-db",
      "database_id": "43cc7b7d-4117-4dbb-a7fb-69fd0868d41f"
    }
  ],

  "observability": { "enabled": true }
}
